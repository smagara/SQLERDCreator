digraph G {
        graph [
            nodesep=0.5;
            rankdir="LR";
            cencentrate=true;
            splines="spline";
            fontname="Helvetica";
            pad="0.2,0.2",
            label="",

        ];

        node [shape=plain, fontname="Helvetica"];
        edge [
            dir=both,
            fontsize=12,
            arrowsize=0.9,
            penwidth=1.0,
            labelangle=32,
            labeldistance=1.8,
            fontname="Helvetica"
        ];

	 core__Players [ label=<
        <table border="0" cellborder="1" cellspacing="0">
        <tr><td bgcolor="grey"><b>core__Players</b></td></tr>
        
		<tr><td port="playerID" align="left" cellpadding="5">playerID <font color="grey60">object</font></td></tr>
		<tr><td port="sportCode" align="left" cellpadding="5">sportCode <font color="grey60">object</font></td></tr>
		<tr><td port="teamCode" align="left" cellpadding="5">teamCode <font color="grey60">object</font></td></tr>
		<tr><td port="positionCode" align="left" cellpadding="5">positionCode <font color="grey60">object</font></td></tr>
		<tr><td port="firstName" align="left" cellpadding="5">firstName <font color="grey60">object</font></td></tr>
		<tr><td port="lastName" align="left" cellpadding="5">lastName <font color="grey60">object</font></td></tr>
		<tr><td port="dateOfBirth" align="left" cellpadding="5">dateOfBirth <font color="grey60">object</font></td></tr>
		<tr><td port="heightInches" align="left" cellpadding="5">heightInches <font color="grey60">object</font></td></tr>
