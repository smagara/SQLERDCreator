		</table>>];

	 core__Players:sportCode->reference__PositionCodes:sportCode;

	 core__Players:sportCode->core__Teams:sportCode;

	 core__Teams:sportCode->reference__Sports:sportCode;

	 reference__PositionCodes:sportCode->reference__Sports:sportCode;

	 stats__Attendance:sportCode->reference__Sports:sportCode;

	 stats__MLBPlayerStats:playerID->core__Players:playerID;

	 stats__NBAPlayerStats:playerID->core__Players:playerID;

	 stats__NFLPlayerStats:playerID->core__Players:playerID;

	 stats__NHLPlayerStats:playerID->core__Players:playerID;
	}