		<tr><td port="college" align="left" cellpadding="5">college <font color="grey60">object</font></td></tr>
		<tr><td port="birthCountry" align="left" cellpadding="5">birthCountry <font color="grey60">object</font></td></tr>
		<tr><td port="birthCityState" align="left" cellpadding="5">birthCityState <font color="grey60">object</font></td></tr>
		<tr><td port="draftYear" align="left" cellpadding="5">draftYear <font color="grey60">object</font></td></tr>
		<tr><td port="seasonYear" align="left" cellpadding="5">seasonYear <font color="grey60">object</font></td></tr>
		</table>>];

