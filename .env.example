# Copy to .env and set values for your environment.
# Priority: if MSSQL_CONNECTION_STRING is set, it is used first.

# Option A: full ODBC connection string (recommended for DBAs)
# MSSQL_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=.;DATABASE=yourDBName;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;"

# Option B/C: parameterized settings
MSSQL_AUTH_MODE=windows
MSSQL_HOST=.
MSSQL_PORT=1433
MSSQL_DATABASE=yourDBName
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# Required when MSSQL_AUTH_MODE=sql
# MSSQL_UID=sa (or DDL-privileged login id)
# MSSQL_PWD=theStrongPassword123
